# Generated by python scripts/quickstart.py init. Never commit real credentials.
RAG_ENVIRONMENT=demo
COMPOSE_PROJECT_NAME=rag-demo
# Docker quickstart web port; bound to localhost only.
RAG_WEB_PORT=5173
DB_NAME=rag_demo
DB_PORT=3307
MILVUS_PORT=19530
MILVUS_HOST=127.0.0.1
MILVUS_URI=http://localhost:19530
DOCLING_PORT=5001
DB_URL=jdbc:mysql://localhost:3307/rag_demo?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USER=rag
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
RAG_SEED_PASSWORD=
RAG_CSRF_SECRET=
DOCLING_API_KEY=
DOCLING_URL=http://localhost:5001
# Unified Docling HybridChunker settings for PDF/DOCX/MD/TXT/etc.
DOCLING_CHUNK_MAX_TOKENS=400
DOCLING_PARENT_MAX_TOKENS=1200
DOCLING_CHUNK_TOKENIZER=sentence-transformers/all-MiniLM-L6-v2
DOCLING_CHUNK_MERGE_PEERS=true
RAG_INDEX_PREFIX=rag_demo
# Python 后端通过 LiteLLM AI Gateway 调用 Chat/Embedding/Reranker 模型，供应商真实密钥由网关持有
LITELLM_PORT=4000
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=
MODEL_BASE_URL=
MODEL_API_KEY=
CHAT_MODEL=
JUDGE_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=20
# DashScope rerank model ID; LiteLLM maps the chat base URL to /compatible-api/v1/reranks.
RERANK_MODEL=

# Durable worker / artifact storage
RAG_EMBEDDED_WORKER=true
RAG_ARTIFACT_STORE=local
# Optional local directory import root. /admin/import-previews can only scan below this directory.
RAG_IMPORT_ROOT=
# Optional cross-environment deletion propagation. Comma-separated peer base URLs.
RAG_DELETION_PEERS=
# Shared token for /api/v1/internal/deletions. Use 32+ random characters when peers are configured.
RAG_DELETION_API_TOKEN=
# Monthly model budget (CNY) and authenticated internal reservation API.
RAG_MONTHLY_BUDGET_CNY=100
RAG_INTERNAL_BUDGET_TOKEN=
RAG_INTERNAL_BUDGET_TENANT=tenant-demo-1
RAG_INTERNAL_BUDGET_CALLER=evaluation
# Set RAG_ARTIFACT_STORE=s3 to use S3/MinIO.
S3_ENDPOINT_URL=http://localhost:9001
S3_BUCKET=rag-artifacts
S3_ACCESS_KEY_ID=ragadmin
S3_SECRET_ACCESS_KEY="" # Generated locally by quickstart.py init.
S3_REGION=us-east-1

# Agent runtime
AGENT_TIMEOUT_SECONDS=120
AGENT_MAX_ROUNDS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_REPEAT_CALL_LIMIT=3
AGENT_MAX_CONTEXT_TOKENS=20000
AGENT_MAX_TOTAL_TOKENS=50000
AGENT_MAX_MODEL_CALLS=12
AGENT_CALL_MAX_ATTEMPTS=3
AGENT_RETRY_BASE_DELAY_SECONDS=0.25
AGENT_CIRCUIT_FAILURE_THRESHOLD=5
AGENT_CIRCUIT_RESET_SECONDS=30
AGENT_FALLBACK_MODEL_ALIAS=
AGENT_APPROVAL_TOOLS=
AGENT_PROMPT_VERSION=agent-v1.1

# Embedded worker pool isolation
RAG_QA_WORKERS=4
RAG_INGEST_WORKERS=2
RAG_EVAL_WORKERS=1

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rag-backend

# Opt-in Langfuse, metadata-only by default. Never commit credentials.
RAG_LANGFUSE_ENABLED=false
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# >=32-byte dedicated secret; changing this intentionally breaks historical HMAC correlations.
RAG_LANGFUSE_ID_HMAC_KEY=
RAG_LANGFUSE_HMAC_VERSION=v1
RAG_LANGFUSE_TARGET_ID=private
RAG_LANGFUSE_SAMPLE_RATE=1
RAG_LANGFUSE_SHUTDOWN_TIMEOUT_SECONDS=2
# METADATA_ONLY or CONTENT; unknown values keep content disabled.
RAG_LANGFUSE_DATA_MODE=METADATA_ONLY
# CONTENT enables bodies for the categories below; API/Worker restart required.
RAG_LANGFUSE_CAPTURE_MODEL=true
RAG_LANGFUSE_CAPTURE_RETRIEVAL=true
RAG_LANGFUSE_CAPTURE_TOOL=true
RAG_LANGFUSE_CAPTURE_QA=true
